# Cipher Clash — environment variables (copy NAMES, fill values from your dashboards)
# NEVER commit real values to git.

# Supabase project (client-visible)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string (Supabase → Settings → Database → Connection string)
SUPABASE_DB_URL=

# Long random string used to sign login tokens
SESSION_SECRET=

# Comma-separated usernames that become admins (can approve reviews)
ADMIN_USERNAMES=

# --- Optional: Web Push notifications (v4) ---
# Leave empty to disable push. To enable: run `npx web-push generate-vapid-keys`
# and paste the two keys below. VAPID_SUBJECT must be a mailto: address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
